  <script>
    // Dock inferior (movil): resalta la seccion visible
    const dock = document.querySelector('[data-dock]');
    if (dock && 'IntersectionObserver' in window) {
      const map = { 'sobre-mi': 'sobre-mi', experiencia: 'sobre-mi', habilidades: 'habilidades', proyectos: 'proyectos', servicios: 'servicios', 'por-que': 'servicios', proceso: 'servicios', industrias: 'servicios', contacto: 'contacto' };
      const links = Object.fromEntries([...dock.querySelectorAll('a[data-dk]')].map((a) => [a.dataset.dk, a]));
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          const k = map[e.target.id];
          Object.values(links).forEach((a) => (a === links[k] ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      Object.keys(map).forEach((id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    }
  </script>
  <script>
    // Filtros por categoria y detalle en <dialog> nativo (se mejora lo que ya existe; sin JS todo sigue visible).
    const grid = document.querySelector('.pgrid');
    const bar = document.querySelector('[data-filters]');
    const dlg = document.querySelector('[data-dlg]');
    const moreBtn = document.querySelector('[data-more]');
    if (grid && moreBtn) {
      grid.classList.add('collapsed');
      const hid = [...grid.querySelectorAll('article')].filter((a) => getComputedStyle(a).display === 'none').length;
      moreBtn.textContent = moreBtn.dataset.t.replace('{n}', hid);
      moreBtn.hidden = hid === 0;
      moreBtn.addEventListener('click', () => { grid.classList.remove('collapsed'); moreBtn.hidden = true; });
    }
    if (grid && bar) {
      bar.hidden = false;
      bar.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-f]');
        if (!b) return;
        const f = b.dataset.f;
        bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        grid.querySelectorAll('article[data-cat]').forEach((a) => { a.hidden = f !== 'all' && (f === 'clients' ? !a.dataset.client : a.dataset.cat !== f); });
        grid.querySelectorAll('.ghead').forEach((h) => { h.hidden = f !== 'all'; });
        if (f !== 'all') { grid.classList.remove('collapsed'); moreBtn && (moreBtn.hidden = true); }
      });
    }
    if (grid && dlg) {
      const dm = dlg.querySelector('[data-dmedia]');
      const db = dlg.querySelector('[data-dbody]');
      grid.addEventListener('click', (e) => {
        if (e.target.closest('.mnav')) return;
        const btn = e.target.closest('[data-open], .media');
        if (!btn) return;
        const card = btn.closest('article');
        const media = card.querySelector('.media').cloneNode(true);
        // En el dialogo el carrusel lo arma el JS de abajo: se deja solo la portada
        const ms = media.querySelector('.mscroll');
        if (ms) ms.replaceWith(...ms.querySelector('.mslide').childNodes);
        media.querySelectorAll('.mdots,.mnav,.gcount').forEach((x) => x.remove());
        media.querySelectorAll('source,img').forEach((x) => { x.sizes = '(min-width:900px) 860px, 96vw'; if (x.loading) x.loading = 'eager'; });
        const body = card.querySelector('.pbody').cloneNode(true);
        body.querySelector('[data-open]')?.remove();
        const pts = body.querySelector('.dpts');
        if (pts) pts.hidden = false;
        const gal = body.querySelector('.gal');
        gal?.remove();
        if (gal && gal.children.length) {
          // Carrusel: la imagen principal + las capturas de la galeria (deslizar, flechas o teclado)
          const slides = [media, ...[...gal.children].map((f) => { f.querySelector('img').loading = 'eager'; return f; })];
          const car = document.createElement('div');
          car.className = 'car';
          const tr = document.createElement('div');
          tr.className = 'ctrack';
          tr.tabIndex = 0;
          tr.setAttribute('role', 'group');
          tr.setAttribute('aria-roledescription', 'carousel');
          slides.forEach((x) => { const sl = document.createElement('div'); sl.className = 'cslide'; sl.appendChild(x); tr.appendChild(sl); });
          const en = document.documentElement.lang === 'en';
          const prev = document.createElement('button');
          const next = document.createElement('button');
          prev.type = next.type = 'button';
          prev.className = 'cbtn prev';
          next.className = 'cbtn next';
          prev.textContent = '‹';
          next.textContent = '›';
          prev.setAttribute('aria-label', en ? 'Previous' : 'Anterior');
          next.setAttribute('aria-label', en ? 'Next' : 'Siguiente');
          const cnt = document.createElement('span');
          cnt.className = 'ccnt';
          cnt.setAttribute('aria-live', 'polite');
          const upd = () => {
            const i = Math.round(tr.scrollLeft / (tr.clientWidth || 1));
            cnt.textContent = (i + 1) + ' / ' + slides.length;
            prev.disabled = i === 0;
            next.disabled = i === slides.length - 1;
          };
          const go = (d) => tr.scrollBy({ left: d * tr.clientWidth, behavior: matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth' });
          prev.onclick = () => go(-1);
          next.onclick = () => go(1);
          tr.addEventListener('scroll', upd, { passive: true });
          tr.addEventListener('keydown', (ev) => {
            if (ev.key === 'ArrowRight') { ev.preventDefault(); go(1); }
            if (ev.key === 'ArrowLeft') { ev.preventDefault(); go(-1); }
          });
          car.append(tr, prev, next, cnt);
          dm.replaceChildren(car);
          upd();
        } else dm.replaceChildren(media);
        db.replaceChildren(...body.childNodes);
        dlg.showModal();
        dlg.querySelector('.dscroll').scrollTop = 0;
        dlg.querySelector('[data-close]')?.focus();
      });
      grid.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const media = e.target.closest('.media');
        if (!media) return;
        e.preventDefault();
        media.closest('article')?.querySelector('[data-open]')?.click();
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.closest('[data-close]')) dlg.close(); });
    }
  </script>
  <script>
    // Vista previa con varias capturas dentro de la tarjeta: deslizar, flechas y puntos; en escritorio avanza sola al pasar el mouse.
    const calm = matchMedia('(prefers-reduced-motion:reduce)').matches;
    const hov = matchMedia('(hover:hover) and (pointer:fine)').matches;
    document.querySelectorAll('.proj .mscroll').forEach((tr) => {
      const n = tr.children.length;
      if (n < 2) return;
      const media = tr.parentElement;
      const dots = document.createElement('div');
      dots.className = 'mdots';
      dots.setAttribute('aria-hidden', 'true');
      for (let k = 0; k < n; k++) dots.appendChild(document.createElement('i'));
      const mk = (c, txt) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'mnav ' + c; b.tabIndex = -1; b.setAttribute('aria-hidden', 'true'); b.textContent = txt; return b; };
      const prev = mk('prev', '‹');
      const next = mk('next', '›');
      const idx = () => Math.round(tr.scrollLeft / (tr.clientWidth || 1));
      const upd = () => {
        const i = idx();
        [...dots.children].forEach((d, k) => d.classList.toggle('on', k === i));
        prev.hidden = i === 0;
        next.hidden = i === n - 1;
      };
      const go = (i, smooth = true) => tr.scrollTo({ left: i * tr.clientWidth, behavior: smooth && !calm ? 'smooth' : 'auto' });
      let timer = 0, manual = false;
      prev.addEventListener('click', (e) => { e.stopPropagation(); manual = true; go(idx() - 1); });
      next.addEventListener('click', (e) => { e.stopPropagation(); manual = true; go(idx() + 1); });
      tr.addEventListener('scroll', upd, { passive: true });
      tr.addEventListener('touchstart', () => { manual = true; }, { passive: true });
      media.append(dots, prev, next);
      upd();
      if (hov && !calm) {
        media.addEventListener('mouseenter', () => {
          tr.querySelectorAll('img').forEach((im) => { im.loading = 'eager'; });
          manual = false;
          clearInterval(timer);
          timer = setInterval(() => { if (!manual) go((idx() + 1) % n); }, 1500);
        });
        media.addEventListener('mouseleave', () => { clearInterval(timer); if (!manual) go(0); });
      }
    });
  </script>
  <script>
    // Formulario: AJAX hacia contact.php. Turnstile (si hay site key) se carga solo al enfocar el formulario.
    const form = document.querySelector('[data-form]');
    if (form) {
      const msg = JSON.parse(form.dataset.msg);
      const status = form.querySelector('[data-status]');
      const btn = form.querySelector('button');
      const t0 = Date.now();
      let cf = '';
      let tsLoaded = false;
      const loadTs = () => {
        const key = form.dataset.sitekey;
        if (!key || tsLoaded) return;
        tsLoaded = true;
        window.__tsReady = () => window.turnstile.render(form.querySelector('[data-ts]'), { sitekey: key, callback: (tk) => (cf = tk), 'expired-callback': () => (cf = '') });
        const sc = document.createElement('script');
        sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__tsReady';
        sc.async = true;
        document.head.appendChild(sc);
      };
      form.addEventListener('focusin', loadTs, { once: true });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'fstat';
        const d = Object.fromEntries(new FormData(form));
        const phoneOk = !d.phone || /^[+()\d\s.-]{6,}$/.test(d.phone.trim());
        const bad = !form.checkValidity() ? (form.email.validity.valid ? msg.invalid : msg.email_bad)
          : !d.email.trim() && !d.phone.trim() ? msg.need_contact
          : !phoneOk ? msg.phone_bad : '';
        if (bad) {
          status.textContent = bad;
          status.classList.add('bad');
          return;
        }
        btn.disabled = true;
        status.textContent = msg.sending;
        try {
          const r = await fetch(form.dataset.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: d.name, email: d.email, phone: d.phone, message: d.message, website: d.website, lang: form.dataset.lang, t: t0, cf }),
          });
          const j = await r.json().catch(() => ({}));
          if (j.ok) {
            if (window.gtag) window.gtag('event', 'generate_lead', { method: 'contact_form' });
            status.textContent = msg.ok;
            status.classList.add('good');
            form.reset();
          } else {
            status.textContent = msg[j.error === 'rate' ? 'rate' : j.error === 'captcha' ? 'captcha' : j.error === 'email' ? 'email_bad' : j.error === 'invalid' ? 'invalid' : 'err'];
            status.classList.add('bad');
            if (window.turnstile && cf) { window.turnstile.reset(); cf = ''; }
          }
        } catch (_) {
          status.textContent = msg.err;
          status.classList.add('bad');
        }
        btn.disabled = false;
      });
    }
  </script>
  <script>
    // Retrato: estatico por defecto, parallax al mover el mouse y, tras 5 s sin tocar nada, una escena
    // (dormido, cromo de mago ausente o programando). Los clics repetidos invocan a Sauron (mas abajo).
    const stg = document.querySelector('[data-stage]');
    const fig = stg && stg.closest('.foto');
    const heroSec = document.querySelector('[data-hero]');
    const calm = matchMedia('(prefers-reduced-motion:reduce)').matches;
    if (fig && heroSec && !calm) {
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
      const loop = () => {
        cx += (tx - cx) * 0.09;
        cy += (ty - cy) * 0.09;
        fig.style.setProperty('--px', cx.toFixed(3));
        fig.style.setProperty('--py', cy.toFixed(3));
        raf = Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(loop) : 0;
      };
      const aim = (x, y) => { tx = x; ty = y; if (!raf) raf = requestAnimationFrame(loop); };
      const clamp = (v) => Math.max(-1, Math.min(1, v));
      if (matchMedia('(hover:hover) and (pointer:fine)').matches) {
        heroSec.addEventListener('pointermove', (e) => {
          const r = heroSec.getBoundingClientRect();
          aim(clamp(((e.clientX - r.left) / r.width - 0.5) * 2), clamp(((e.clientY - r.top) / r.height - 0.5) * 2));
        }, { passive: true });
        heroSec.addEventListener('pointerleave', () => aim(0, 0));
      }
      // Celular: el parallax sigue la inclinacion del telefono (en iOS se pide permiso con el primer toque)
      if (!matchMedia('(hover:hover) and (pointer:fine)').matches && 'DeviceOrientationEvent' in window) {
        let base = null;
        const onTilt = (e) => {
          if (e.gamma == null || e.beta == null || document.documentElement.classList.contains('mordor') || fig.dataset.mood) return;
          if (base === null) base = e.beta;
          base += (e.beta - base) * 0.02;
          aim(clamp(e.gamma / 22), clamp((e.beta - base) / 22));
        };
        const listen = () => addEventListener('deviceorientation', onTilt, { passive: true });
        const DOE = window.DeviceOrientationEvent;
        if (typeof DOE.requestPermission === 'function') {
          addEventListener('pointerdown', () => { DOE.requestPermission().then((r) => { if (r === 'granted') listen(); }).catch(() => {}); }, { once: true });
        } else listen();
      }
      // Escenas de reposo
      // Orden fijo: cafe, programando, durmiendo y, al final, el cartel (que se queda hasta que haya interaccion)
      const scenes = ['coffee', 'code', 'sleep', 'away'];
      let step = 0, mood = '', timer = 0, visible = true;
      const root = document.documentElement;
      const setMood = (m) => {
        mood = m;
        if (m) { fig.dataset.mood = m; aim(0, 0); } else delete fig.dataset.mood;
      };
      const idle = () => {
        if (!visible || document.hidden || root.classList.contains('mordor')) { arm(); return; }
        setMood(scenes[step]);
        step++;
        if (step < scenes.length) timer = setTimeout(idle, 10000);
      };
      const arm = () => { clearTimeout(timer); timer = setTimeout(idle, 5000); };
      const wake = () => { if (mood) setMood(''); step = 0; arm(); };
      ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'].forEach((ev) => addEventListener(ev, wake, { passive: true }));
      if ('IntersectionObserver' in window) new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (!visible && mood) setMood(''); }).observe(heroSec);
      arm();
      // Las fotos de las escenas se piden despues de la carga, para no competir con la foto principal
      addEventListener('load', () => setTimeout(() => fig.querySelectorAll('img[loading=lazy]').forEach((im) => { im.loading = 'eager'; }), 1500), { once: true });
    }
  </script>
  <script>
    // Detalles de interaccion. Todo arranca con la primera accion del usuario, nunca durante la carga.
    // 1) Estela de brasas/luz que sigue al mouse (solo con mouse y sin "reducir movimiento").
    if (matchMedia('(hover:hover) and (pointer:fine)').matches && !matchMedia('(prefers-reduced-motion:reduce)').matches) {
      let cv, cx, parts = [], raf = 0, lx = -1, ly = -1, hue = 0;
      const root = document.documentElement;
      const size = () => { cv.width = innerWidth; cv.height = innerHeight; };
      const frame = (now) => {
        cx.clearRect(0, 0, cv.width, cv.height);
        cx.globalCompositeOperation = 'lighter';
        parts = parts.filter((p) => now - p.t0 < p.life);
        for (const p of parts) {
          const k = (now - p.t0) / p.life;
          const r = p.r * (1 - k * 0.5);
          const g = cx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
          g.addColorStop(0, 'hsla(' + p.h + ',95%,62%,' + 0.34 * (1 - k) + ')');
          g.addColorStop(1, 'hsla(' + p.h + ',95%,55%,0)');
          cx.fillStyle = g;
          cx.beginPath(); cx.arc(p.x, p.y, r, 0, 6.2832); cx.fill();
          p.y -= p.up;
        }
        raf = parts.length ? requestAnimationFrame(frame) : 0;
      };
      const add = (x, y) => {
        const mordor = root.classList.contains('mordor');
        hue = (hue + 7) % 60;
        parts.push({ x, y, r: 30 + Math.random() * 22, life: 750 + Math.random() * 350, t0: performance.now(), up: mordor ? 0.7 : 0.15,
          h: mordor ? 12 + hue * 0.7 : (hue < 30 ? 232 - hue : 172 + (hue - 30) * 0.2) });
        if (parts.length > 70) parts.shift();
        if (!raf) raf = requestAnimationFrame(frame);
      };
      const move = (e) => {
        if (!cv) {
          cv = document.createElement('canvas');
          cv.setAttribute('aria-hidden', 'true');
          cv.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:45';
          document.body.appendChild(cv); cx = cv.getContext('2d'); size();
          addEventListener('resize', size, { passive: true });
        }
        const x = e.clientX, y = e.clientY;
        if (lx < 0 || Math.hypot(x - lx, y - ly) > 16) { add(x, y); lx = x; ly = y; }
      };
      addEventListener('pointermove', move, { passive: true });
    }
    // 2) Huevo de pascua: 5 clics seguidos en la foto invocan (o disipan) la sombra de Mordor.
    const egg = document.querySelector('[data-egg]');
    if (egg) {
      const txt = JSON.parse(egg.dataset.egg);
      const out = document.querySelector('[data-egg-msg]');
      let n = 0, t1 = 0, t2 = 0;
      egg.addEventListener('click', () => {
        n++; clearTimeout(t1); t1 = setTimeout(() => { n = 0; }, 1500);
        if (n < 5) return;
        n = 0;
        const on = document.documentElement.classList.toggle('mordor');
        out.textContent = on ? txt.on : txt.off;
        out.classList.add('show'); clearTimeout(t2); t2 = setTimeout(() => out.classList.remove('show'), 3200);
      });
    }
  </script>
  <script>
    // GSAP: el modulo se descarga 4 s despues de `load`, cuando el navegador esta libre, y la
    // animacion arranca con la primera interaccion (scroll, toque, tecla) o a los 10 s.
    // Sin interaccion no hay trabajo extra en el hilo principal durante la carga.
    if (!matchMedia('(prefers-reduced-motion:reduce)').matches) {
      let mod;
      let go = false;
      const evs = ['scroll', 'touchstart', 'pointerdown', 'keydown', 'wheel'];
      const run = () => mod && mod.then((m) => m.init());
      const start = () => {
        if (go) return;
        go = true;
        evs.forEach((e) => removeEventListener(e, start));
        if (mod) run();
        else {
          mod = import('../scripts/anim.js');
          run();
        }
      };
      evs.forEach((e) => addEventListener(e, start, { passive: true }));
      // ?eager arranca GSAP en `load` (solo para medir el peor caso con Lighthouse)
      if (location.search.includes('eager')) addEventListener('load', start, { once: true });
      addEventListener('load', () => {
        const fetchMod = () => { if (!mod) { mod = import('../scripts/anim.js'); if (go) run(); } };
        // Espera 4 s tras `load` para no competir con la carga inicial; con interaccion antes, arranca antes.
        setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(fetchMod, { timeout: 2000 }) : fetchMod()), 4000);
        setTimeout(start, 10000);
      }, { once: true });
    }
  </script>
  <ChatWidget t={t} />
</body>
</html>
