---
import '../styles/global.css';
import { Picture, Image } from 'astro:assets';
import { brand, gen, tagIcon } from '../icons.js';
import { allItems } from '../lib/projects.js';
import ChatWidget from './ChatWidget.astro';
import eps1 from '../assets/proyectos/easy-pdf-inicio.png';
import eps2 from '../assets/proyectos/easy-pdf-lector.jpg';
import moova from '../assets/proyectos/moova-popup.png';
import imgGen from '../assets/proyectos/img-generator.png';
import perf from '../assets/proyectos/web-performance.png';
import insight from '../assets/proyectos/insight-demo.png';
import buscador from '../assets/proyectos/buscador-replica.png';
import gletir from '../assets/proyectos/gletir-tracker.png';
import kiosko from '../assets/proyectos/kiosko.png';
import habit from '../assets/proyectos/tracker-habits.png';
import nova from '../assets/proyectos/nova-web.jpg';
import origen from '../assets/proyectos/origen-34.jpg';
import mPerf from '../assets/proyectos/m-web-performance.png';
import mInsight from '../assets/proyectos/m-insight-demo.png';
import mBuscador from '../assets/proyectos/m-buscador-replica.png';
import heroBg from '../assets/hero/fondo.webp';
import heroMan from '../assets/hero/gustavo-recorte.webp';
import heroDown from '../assets/hero/gustavo-mirando-abajo.webp';
import heroCode from '../assets/hero/gustavo-programando.webp';
import heroSauron from '../assets/hero/gustavo-sauron.webp';
import heroCafe from '../assets/hero/gustavo-cafe.webp';

// Galerias por proyecto (assets/proyectos/galeria/<id>/N.webp) y capturas de sitios en linea (assets/trabajo/<id>.webp)
const galFiles = import.meta.glob('../assets/proyectos/galeria/*/*.webp', { eager: true, import: 'default' });
const gallery = {};
for (const [p, img] of Object.entries(galFiles)) { const m = p.match(/galeria\/([^/]+)\/(\d+)\.webp$/); (gallery[m[1]] ??= [])[Number(m[2]) - 1] = img; }
const workFiles = import.meta.glob('../assets/trabajo/*.webp', { eager: true, import: 'default' });
const workImg = Object.fromEntries(Object.entries(workFiles).map(([p, img]) => [p.match(/([^/]+)\.webp$/)[1], img]));

const { t } = Astro.props;
const ENDPOINT = 'https://gustavobentancor.com/gsoft-studio/contact.php';
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = t.lang === 'en';
const path = isEn ? '/en/' : '/';
// URL canonica unica: el dominio propio (la copia de GitHub Pages apunta aqui para no duplicar contenido)
const CANON = 'https://gustavobentancor.com';
const canonical = `${CANON}${path}`;
const alt = `${CANON}${isEn ? '/' : '/en/'}`;
const ogAlt = isEn ? 'Gustavo Bentancor: fast websites, SEO and custom apps' : 'Gustavo Bentancor: webs rápidas, SEO y apps a medida';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${CANON}/#org`,
      name: t.brand,
      url: `${CANON}/`,
      description: t.meta.description,
      image: `${CANON}/og.png`,
      founder: { '@id': `${CANON}/#person` },
      sameAs: [t.github, t.linkedin],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.title,
        itemListElement: t.services.items.map((x) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: x.title, description: x.text } })),
      },
    },
    {
      '@type': 'Person',
      '@id': `${CANON}/#person`,
      name: 'Gustavo Bentancor',
      jobTitle: 'Full-Stack Developer & Product Engineer',
      url: `${CANON}/`,
      image: `${CANON}/og.png`,
      address: { '@type': 'PostalAddress', addressLocality: 'Montevideo', addressCountry: 'UY' },
      worksFor: { '@id': `${CANON}/#org` },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad ORT Uruguay' },
      knowsAbout: ['Web development', 'Technical SEO', 'Core Web Vitals', 'Astro', 'JavaScript', 'PHP', 'Chrome extensions', 'Progressive web apps'],
      subjectOf: { '@type': 'DigitalDocument', name: t.cv.download, url: `${CANON}/${t.cv.file}`, encodingFormat: 'application/pdf' },
      sameAs: [t.github, t.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': `${CANON}/#web`,
      url: `${CANON}/`,
      name: t.brand,
      inLanguage: ['es', 'en'],
      publisher: { '@id': `${CANON}/#org` },
    },
  ],
};
const other = isEn ? `${base}/` : `${base}/en/`;
const fontCss = `@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${base}/fonts/inter-latin-wght-normal.woff2") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const images = { 'gletir-tracker': gletir, 'easy-pdf-free': null, 'tracker-habits': habit, 'moova-tracker-extension': moova, 'img-generator': imgGen, 'web-performance': perf, 'insight-demo': insight, 'buscador-replica': buscador, 'kiosko': kiosko, 'nova-web': nova, 'origen-34': origen };
// Orden: Gletir destacado, luego sitios web (con vista movil) y luego aplicaciones/herramientas propias
// Trabajos para clientes y demos propias (t.work.items) se muestran como proyectos mas
const all = allItems(t, base);
// Orden por importancia: primero el front-end web (sitios reales y demos), despues apps, extensiones y herramientas
const cover = (p) => images[p.id] ?? workImg[p.img ?? p.id];
// Orden por importancia (prioridad de Gustavo): sitios BROU, demos de front-end, apps propias y al final extensiones y herramientas
const order = [
  'brou-mibrou', 'brou-beneficios', 'brou-asistencia', 'insight-demo', 'nova-web', 'origen-34', 'nodo-corp', 'talento-sur', 'buscador-replica', 'grano-sur',
  'eventosanime', 'kiosko', 'entradas-eventos', 'mesalista', 'urugol',
  'auf', 'web-performance', 'interbalnearios', 'elarcon', 'museo-celeste', 'rincon', 'rumbo-sur', 'banners',
  'easy-pdf-free', 'gletir-tracker', 'tracker-habits', 'moova-tracker-extension', 'img-generator',
];
const catOf = Object.fromEntries(order.map((id) => [id, 'web']));
Object.assign(catOf, { 'easy-pdf-free': 'apps', 'tracker-habits': 'apps', 'kiosko': 'apps', 'entradas-eventos': 'apps', 'mesalista': 'apps', 'gletir-tracker': 'ext', 'moova-tracker-extension': 'ext', 'img-generator': 'ext' });
const mobile = { 'web-performance': mPerf, 'insight-demo': mInsight, 'buscador-replica': mBuscador };
// Un proyecto sin captura todavia no se muestra (aparece solo cuando existe su imagen)
const sorted = order.map((id) => all.find((x) => x.id === id)).filter((p) => p && (p.id === 'easy-pdf-free' || cover(p)));
// Vista "Todos": 15 tarjetas en escritorio (5 filas de 3) y 6 en celular; el resto se despliega con un boton
const LIMIT = 15, LIMIT_M = 6;
const extra = new Set(sorted.slice(LIMIT).map((p) => p.id));
const extraM = new Set(sorted.slice(LIMIT_M).map((p) => p.id));
const hiddenCount = extra.size;
const mediaClass = { 'gletir-tracker': 'shot', 'tracker-habits': 'logo', 'moova-tracker-extension': 'contain', 'easy-pdf-free': 'duo' };
const icons = {
  cog: 'M12 15a3 3 0 100-6 3 3 0 000 6zm7.4-3a7.4 7.4 0 00-.1-1.2l2-1.6-2-3.4-2.4 1a7.5 7.5 0 00-2-1.2L14.5 3h-4l-.4 2.6a7.5 7.5 0 00-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 000 2.4l-2 1.6 2 3.4 2.4-1a7.5 7.5 0 002 1.2l.4 2.6h4l.4-2.6a7.5 7.5 0 002-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2z',
  spark: 'M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5l-2.2-6.3L3.5 10l6.3-1.7L12 2zm7 13l1 2.8 2.8 1-2.8 1-1 2.8-1-2.8-2.8-1 2.8-1 1-2.8z',
  bolt: 'M13 2L4 14h6l-1 8 9-12h-6l1-8z',
  box: 'M12 2l9 4.5v11L12 22l-9-4.5v-11L12 2zm0 2.2L5.5 7.5 12 10.8l6.5-3.3L12 4.2zM5 9.2v7.1l6 3V12.2L5 9.2zm14 0l-6 3v7.1l6-3V9.2z',
};
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description}>
  <meta name="theme-color" content="#07080d">
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="es" href={isEn ? alt : canonical}>
  <link rel="alternate" hreflang="en" href={isEn ? canonical : alt}>
  <link rel="alternate" hreflang="x-default" href={isEn ? alt : canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={t.meta.title}>
  <meta property="og:description" content={t.meta.description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={t.brand}>
  <meta property="og:locale" content={isEn ? 'en_US' : 'es_ES'}>
  <meta property="og:locale:alternate" content={isEn ? 'es_ES' : 'en_US'}>
  <meta property="og:image" content={`${CANON}/og.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={t.meta.title}>
  <meta name="twitter:description" content={t.meta.description}>
  <meta name="twitter:image" content={`${CANON}/og.png`}>
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="preload" href={`${base}/fonts/inter-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={fontCss}></style>
  <script is:inline>
    (function(){var r=document.documentElement;if(!matchMedia('(prefers-reduced-motion:reduce)').matches){r.classList.add('anim');window.__af=setTimeout(function(){r.classList.remove('anim')},6000)}})();
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TEFWE35W1K"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
    gtag('js',new Date());gtag('config','G-TEFWE35W1K');
    // Eventos de CTA: descarga de CV, clics a contacto, enlaces externos y salida a tiendas/demos.
    document.addEventListener('click',function(e){
      var a=e.target.closest&&e.target.closest('a,button[data-open]');if(!a)return;
      var h=a.getAttribute('href')||'',p={link_text:(a.textContent||'').trim().slice(0,60)};
      if(a.hasAttribute("data-cv"))gtag('event','cv_download',p);
      else if(h==='#contacto')gtag('event','cta_contact',p);
      else if(/^mailto:/.test(h))gtag('event','click_email',p);
      else if(/^tel:/.test(h))gtag('event','click_phone',p);
      else if(/^https?:/.test(h)&&h.indexOf(location.host)<0){p.link_url=h;gtag('event','outbound_click',p)}
    });
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="hd">
    <div class="wrap">
      <a class="logo" href={`${base}${path}`} aria-label={t.brand}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#10131e" stroke="#1f2434"/><path d="M9 21l5-10 4 7 2-4 3 7" fill="none" stroke="#7c8cff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {t.brand}
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#sobre-mi">{t.nav.about}</a>
        <a href="#habilidades">{t.nav.skills}</a>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#servicios">{t.nav.services}</a>
        <a href="#proceso">{t.nav.process}</a>
      </nav>
      <a class="lang" href={other} hreflang={isEn ? 'es' : 'en'} title={t.nav.other.title}>{t.nav.other.label}</a>
      <a class="btn btn-p" href="#contacto">{t.nav.cta}</a>
    </div>
  </header>

  <nav class="dock" aria-label={t.nav.dock} data-dock>
    <a href="#sobre-mi" data-dk="sobre-mi"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg><span>{t.nav.story}</span></a>
    <a href="#habilidades" data-dk="habilidades"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/></svg><span>{t.nav.skills}</span></a>
    <a href="#proyectos" data-dk="proyectos"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/></svg><span>{t.nav.projects}</span></a>
    <a href="#servicios" data-dk="servicios"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2.2"/><path d="M9 7V5.2A1.7 1.7 0 0110.7 3.5h2.6A1.7 1.7 0 0115 5.2V7M3 13h18"/></svg><span>{t.nav.services}</span></a>
    <a href="#contacto" data-dk="contacto"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.2"/><path d="M3.5 7.5L12 13.2l8.5-5.7"/></svg><span>{t.nav.contact}</span></a>
  </nav>

  <main id="main">
    <section class="hero" data-hero>
      <div class="orb o1" data-orb="1"></div>
      <div class="orb o2" data-orb="2"></div>
      <div class="wrap">
        <figure class="foto" data-egg={JSON.stringify(t.egg)}>
          <div class="stage" data-stage>
            <div class="layer bg"><Image src={heroBg} width={520} format="webp" quality={70} alt="" loading="eager" /></div>
              <svg class="eye" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
                <defs>
                  <radialGradient id="eg" cx="50%" cy="50%" r="55%"><stop offset="0" stop-color="#fff3a0"/><stop offset=".35" stop-color="#ffb300"/><stop offset=".75" stop-color="#ff3d00"/><stop offset="1" stop-color="#7a0900"/></radialGradient>
                  <filter id="eglow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6"/></filter>
                </defs>
                <path d="M6 60 Q100 -14 194 60 Q100 134 6 60Z" fill="#ff3d00" filter="url(#eglow)" opacity=".85"/>
                <path d="M6 60 Q100 -14 194 60 Q100 134 6 60Z" fill="url(#eg)" stroke="#2a0300" stroke-width="3"/>
                <ellipse cx="100" cy="60" rx="8" ry="40" fill="#120100"/>
              </svg>
            <div class="layer man">
              <div class="pose">
                <Picture src={heroMan} formats={["avif", "webp"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width:900px) 340px, 66vw" alt="Gustavo Bentancor" loading="eager" fetchpriority="high" />
                <Picture src={heroDown} formats={["avif", "webp"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width:900px) 340px, 66vw" alt="" loading="lazy" />
                <Picture src={heroCode} formats={["avif", "webp"]} fallbackFormat="webp" widths={[360, 540, 720]} sizes="(min-width:900px) 340px, 66vw" alt="" loading="lazy" />
                <Picture src={heroSauron} formats={["avif", "webp"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width:900px) 340px, 66vw" alt="" loading="lazy" />
                <Picture src={heroCafe} formats={["avif", "webp"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width:900px) 340px, 66vw" alt="" loading="lazy" />
              </div>
            </div>
          </div>
          <div class="embers" aria-hidden="true"><i style="--l:47%;--d:3.03s;--t:3.39s;--s:3px"></i><i style="--l:15%;--d:2.63s;--t:2.79s;--s:3px"></i><i style="--l:70%;--d:0.69s;--t:2.77s;--s:6px"></i><i style="--l:14%;--d:0.77s;--t:3.70s;--s:3px"></i><i style="--l:78%;--d:0.40s;--t:3.05s;--s:3px"></i><i style="--l:79%;--d:1.87s;--t:2.70s;--s:4px"></i><i style="--l:11%;--d:1.78s;--t:2.87s;--s:6px"></i><i style="--l:24%;--d:1.73s;--t:3.74s;--s:4px"></i><i style="--l:19%;--d:1.86s;--t:3.88s;--s:5px"></i><i style="--l:18%;--d:1.75s;--t:2.73s;--s:3px"></i><i style="--l:85%;--d:0.66s;--t:3.96s;--s:6px"></i><i style="--l:46%;--d:1.49s;--t:4.45s;--s:5px"></i><i style="--l:44%;--d:0.79s;--t:2.96s;--s:4px"></i><i style="--l:16%;--d:1.84s;--t:3.65s;--s:5px"></i></div>
          <div class="hpcard" aria-hidden="true">
            <span class="no">{t.idle.card.no}</span>
            <div class="win"><i class="sp s1">✦</i><i class="sp s2">✧</i><i class="sp s3">✦</i><div class="sign"><i class="rope r1"></i><i class="rope r2"></i><div class="board"><b>{t.idle.card.signTitle}</b><span>{t.idle.card.sign}</span><small>{t.idle.card.back}</small></div></div></div>
            <div class="plate"><b>{t.idle.card.name}</b><span>{t.idle.card.role}</span><small>{t.idle.card.power}</small></div>
          </div>
          <div class="glow" aria-hidden="true"></div>
          <div class="glyphs" aria-hidden="true"><i>{'{ }'}</i><i>&lt;/&gt;</i><i>=&gt;</i><i>;</i><i>[ ]</i><i>( )</i></div>
          <svg class="laptop" viewBox="0 0 300 150" aria-hidden="true" focusable="false">
            <path d="M18 138 L282 138 L292 148 L8 148 Z" fill="#3a3d49"/>
            <rect x="34" y="8" width="232" height="132" rx="10" fill="#1d2029" stroke="#4b4f5e" stroke-width="2"/>
            <g class="lg"><circle cx="150" cy="74" r="14" fill="none" stroke="#7c8cff" stroke-width="3" opacity=".85"/><path d="M143 74 l5 6 l10 -12" fill="none" stroke="#36e2c0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
          </svg>
          <div class="steam" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="zzz" aria-hidden="true"><i>Z</i><i>z</i><i>z</i></div>
        </figure>
        <p class="egg-msg" role="status" aria-live="polite" data-egg-msg></p>
        <div class="hid">
          <span class="badge"><i></i>{t.hero.availability}</span>
          <h1>
            <span class="ln"><span style="--i:0">{t.hero.hello[0]}</span></span>
            <span class="ln"><span class="g" style="--i:1">{t.hero.hello[1]}</span></span>
          </h1>
          <p class="hrole">{t.hero.role}</p>
          <p class="lead">{t.hero.lead}</p>
          <ul class="facts">
            {t.hero.facts.map((x) => <li>{x}</li>)}
          </ul>
          <div class="cta">
            <a class="btn btn-p" href="#contacto">{t.hero.primary}</a>
            <a class="btn btn-s" href="#proyectos">{t.hero.secondary}</a>
            <a class="btn btn-s" href={`${base}/${t.cv.file}`} download={t.cv.name} data-cv>{t.cv.download}</a>
          </div>
          <p class="hlinks">
            <a class="ibtn" href={t.github} target="_blank" rel="noopener" aria-label={isEn ? 'GitHub, opens in a new tab' : 'GitHub, se abre en otra pestaña'} title="GitHub">
              <svg class="gi" aria-hidden="true"><use href={`${base}/icons.svg#siGithub`} /></svg>
              <svg class="ar" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"/></svg>
            </a>
            <a class="ibtn" href={t.linkedin} target="_blank" rel="noopener" aria-label={isEn ? 'LinkedIn, opens in a new tab' : 'LinkedIn, se abre en otra pestaña'} title="LinkedIn">
              <svg class="gi" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9.75h4V21H3V9.75zM9.5 9.75h3.8v1.6h.06c.53-1 1.82-2.05 3.75-2.05 4 0 4.74 2.6 4.74 6V21h-4v-4.9c0-1.2-.02-2.7-1.7-2.7s-1.9 1.3-1.9 2.6V21h-4V9.75z"/></svg>
              <svg class="ar" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"/></svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <section id="sobre-mi" class="story-s cv" style="--m:820px;--d:560px">
      <div class="wrap story">
        <div class="sbody">
          <p class="kick" data-r>{t.story.kicker}</p>
          <h2 data-r>{t.story.title}</h2>
          <div class="prose" data-r>
            {t.story.paragraphs.map((p, i) => <p class:list={[i === 0 && 'lede']}>{p}</p>)}
          </div>
        </div>
        <ul class="sgr" aria-label={t.stats.label}>
          {t.stats.items.map((x) => <li data-r="card"><b>{x.n}</b><span>{x.label}</span></li>)}
        </ul>
      </div>
    </section>

