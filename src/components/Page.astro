---
import '../styles/global.css';
import { Picture } from 'astro:assets';
import { brand, gen } from '../icons.js';
import eps1 from '../assets/proyectos/easy-pdf-inicio.png';
import eps2 from '../assets/proyectos/easy-pdf-lector.jpg';
import moova from '../assets/proyectos/moova-popup.png';
import imgGen from '../assets/proyectos/img-generator.png';
import perf from '../assets/proyectos/web-performance.png';
import insight from '../assets/proyectos/insight-demo.png';
import buscador from '../assets/proyectos/buscador-replica.png';
import gletir from '../assets/proyectos/gletir-tracker.png';
import habit from '../assets/proyectos/tracker-habits.png';
import mPerf from '../assets/proyectos/m-web-performance.png';
import mInsight from '../assets/proyectos/m-insight-demo.png';
import mBuscador from '../assets/proyectos/m-buscador-replica.png';
import foto from '../assets/gustavo.jpg';

const { t } = Astro.props;
const ENDPOINT = 'https://gustavobentancor.com/gsoft-studio/contact.php';
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = t.lang === 'en';
const path = isEn ? '/en/' : '/';
// URL canonica unica: el dominio propio (la copia de GitHub Pages apunta aqui para no duplicar contenido)
const CANON = 'https://gustavobentancor.com/gsoft-studio';
const canonical = `${CANON}${path}`;
const alt = `${CANON}${isEn ? '/' : '/en/'}`;
const ogAlt = isEn ? 'Gsoft Studio: we solve what your business needs, accelerated with AI' : 'Gsoft Studio: resolvemos lo que tu empresa necesita, acelerado con IA';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${CANON}/#org`,
      name: t.brand,
      url: `${CANON}/`,
      email: t.email,
      description: t.meta.description,
      image: `${CANON}/og.png`,
      founder: { '@type': 'Person', name: 'Gustavo Bentancor', jobTitle: 'Full-Stack Developer & Product Engineer', sameAs: [t.github, t.linkedin] },
      sameAs: [t.github, t.linkedin],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.title,
        itemListElement: t.services.items.map((x) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: x.title, description: x.text } })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${CANON}/#web`,
      url: `${CANON}/`,
      name: t.brand,
      inLanguage: ['es', 'en'],
      publisher: { '@id': `${CANON}/#org` },
    },
  ],
};
const other = isEn ? `${base}/` : `${base}/en/`;
const fontCss = `@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${base}/fonts/inter-latin-wght-normal.woff2") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const images = { 'gletir-tracker': gletir, 'easy-pdf-free': null, 'tracker-habits': habit, 'moova-tracker-extension': moova, 'img-generator': imgGen, 'web-performance': perf, 'insight-demo': insight, 'buscador-replica': buscador };
// Orden: Gletir destacado, luego sitios web (con vista movil) y luego aplicaciones/herramientas propias
const order = ['gletir-tracker', 'web-performance', 'insight-demo', 'buscador-replica', 'easy-pdf-free', 'tracker-habits', 'moova-tracker-extension', 'img-generator'];
const groupOf = { 'web-performance': 'web', 'insight-demo': 'web', 'buscador-replica': 'web', 'easy-pdf-free': 'own', 'tracker-habits': 'own', 'moova-tracker-extension': 'own', 'img-generator': 'own' };
const catOf = { 'web-performance': 'web', 'insight-demo': 'web', 'buscador-replica': 'web', 'easy-pdf-free': 'apps', 'tracker-habits': 'apps', 'gletir-tracker': 'ext', 'moova-tracker-extension': 'ext', 'img-generator': 'ext' };
const featIds = ['gletir-tracker', 'web-performance'];
const mobile = { 'web-performance': mPerf, 'insight-demo': mInsight, 'buscador-replica': mBuscador };
const sorted = order.map((id) => t.projects.items.find((x) => x.id === id));
const mediaClass = { 'gletir-tracker': 'shot', 'tracker-habits': 'logo', 'moova-tracker-extension': 'contain', 'easy-pdf-free': 'duo' };
const icons = {
  cog: 'M12 15a3 3 0 100-6 3 3 0 000 6zm7.4-3a7.4 7.4 0 00-.1-1.2l2-1.6-2-3.4-2.4 1a7.5 7.5 0 00-2-1.2L14.5 3h-4l-.4 2.6a7.5 7.5 0 00-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 000 2.4l-2 1.6 2 3.4 2.4-1a7.5 7.5 0 002 1.2l.4 2.6h4l.4-2.6a7.5 7.5 0 002-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2z',
  spark: 'M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5l-2.2-6.3L3.5 10l6.3-1.7L12 2zm7 13l1 2.8 2.8 1-2.8 1-1 2.8-1-2.8-2.8-1 2.8-1 1-2.8z',
  bolt: 'M13 2L4 14h6l-1 8 9-12h-6l1-8z',
  box: 'M12 2l9 4.5v11L12 22l-9-4.5v-11L12 2zm0 2.2L5.5 7.5 12 10.8l6.5-3.3L12 4.2zM5 9.2v7.1l6 3V12.2L5 9.2zm14 0l-6 3v7.1l6-3V9.2z',
};
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description}>
  <meta name="theme-color" content="#07080d">
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="es" href={isEn ? alt : canonical}>
  <link rel="alternate" hreflang="en" href={isEn ? canonical : alt}>
  <link rel="alternate" hreflang="x-default" href={isEn ? alt : canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={t.meta.title}>
  <meta property="og:description" content={t.meta.description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={t.brand}>
  <meta property="og:locale" content={isEn ? 'en_US' : 'es_ES'}>
  <meta property="og:locale:alternate" content={isEn ? 'es_ES' : 'en_US'}>
  <meta property="og:image" content={`${CANON}/og.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={t.meta.title}>
  <meta name="twitter:description" content={t.meta.description}>
  <meta name="twitter:image" content={`${CANON}/og.png`}>
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="preload" href={`${base}/fonts/inter-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={fontCss}></style>
  <script is:inline>
    (function(){var r=document.documentElement;if(!matchMedia('(prefers-reduced-motion:reduce)').matches){r.classList.add('anim');window.__af=setTimeout(function(){r.classList.remove('anim')},6000)}})();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="hd">
    <div class="wrap">
      <a class="logo" href={`${base}${path}`} aria-label={t.brand}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#10131e" stroke="#1f2434"/><path d="M9 21l5-10 4 7 2-4 3 7" fill="none" stroke="#7c8cff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {t.brand}
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#servicios">{t.nav.services}</a>
        <a href="#proceso">{t.nav.process}</a>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#sobre-mi">{t.nav.about}</a>
      </nav>
      <a class="lang" href={other} hreflang={isEn ? 'es' : 'en'} title={t.nav.other.title}>{t.nav.other.label}</a>
      <a class="btn btn-p" href="#contacto">{t.nav.cta}</a>
      <details class="menu">
        <summary aria-label="Menu"><span class="ic"></span></summary>
        <nav aria-label="Menu">
          <a href="#servicios">{t.nav.services}</a>
          <a href="#proceso">{t.nav.process}</a>
          <a href="#proyectos">{t.nav.projects}</a>
          <a href="#sobre-mi">{t.nav.about}</a>
          <a href="#contacto">{t.nav.contact}</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <section class="hero" data-hero>
      <div class="orb o1" data-orb="1"></div>
      <div class="orb o2" data-orb="2"></div>
      <div class="wrap">
        <div>
          <span class="badge"><i></i>{t.hero.badge}</span>
          <h1>
            <span class="ln"><span style="--i:0">{t.hero.title[0]}</span></span>
            <span class="ln"><span style="--i:1">{t.hero.title[1]}</span></span>
            <span class="ln"><span class="g" style="--i:2">{t.hero.title[2]}</span></span>
          </h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="cta">
            <a class="btn btn-p" href="#contacto">{t.hero.primary}</a>
            <a class="btn btn-s" href="#proyectos">{t.hero.secondary}</a>
          </div>
        </div>
        <div class="flow" aria-hidden="true" data-flow>
          <div class="pulse"><i data-pulse></i></div>
          <div class="node"><b>1</b>{t.hero.flow[0]}</div>
          <div class="node"><b>2</b>{t.hero.flow[1]}</div>
          <div class="node"><b>3</b>{t.hero.flow[2]}</div>
          <p>{t.hero.flowNote}</p>
        </div>
      </div>
    </section>

    <div class="stats">
      <div class="wrap">
        <ul class="sgr" aria-label={t.stats.label}>
          {t.stats.items.map((x) => <li><b>{x.n}</b><span>{x.label}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="strip">
      <small>{t.stack.label}</small>
      <ul class="track" data-track>
        {t.stack.items.map((s) => <li>{s}</li>)}
        {t.stack.items.map((s) => <li aria-hidden="true">{s}</li>)}
      </ul>
    </div>

    <section id="servicios" class="cv" style="--m:1230px;--d:700px">
      <div class="wrap">
        <p class="kick" data-r>{t.services.kicker}</p>
        <h2 data-r>{t.services.title}</h2>
        <div class="grid4">
          {t.services.items.map((s) => (
            <article class="card" data-r="card">
              <div class="ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons[s.icon]}/></svg></div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proceso" class="alt cv" style="--m:830px;--d:600px">
      <div class="wrap">
        <p class="kick" data-r>{t.process.kicker}</p>
        <h2 data-r>{t.process.title}</h2>
        <div class="steps" data-steps role="list">
          <span class="bar" data-bar aria-hidden="true"></span>
          {t.process.steps.map((s) => (
            <div class="step" role="listitem" data-r="step">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="proyectos" class="cv" style="--m:6600px;--d:3500px">
      <div class="wrap">
        <p class="kick" data-r>{t.projects.kicker}</p>
        <h2 data-r>{t.projects.title}</h2>
        <p class="sub" data-r>{t.projects.lead}</p>
        <div class="filters" role="group" aria-label={t.projects.filterLabel} data-filters hidden>
          {['all', 'web', 'apps', 'ext'].map((k) => (
            <button type="button" class="chip" data-f={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{t.projects.filters[k]}</button>
          ))}
        </div>
        <div class="pgrid">
          {sorted.map((p, i) => (
            <Fragment>
              {groupOf[p.id] && groupOf[p.id] !== groupOf[sorted[i - 1]?.id] && <h3 class="ghead" data-r>{t.projects.groups[groupOf[p.id]]}</h3>}
            <article class:list={['proj', { feat: featIds.includes(p.id) }]} data-r="card" data-cat={catOf[p.id]}>
              <div class:list={['media', mediaClass[p.id]]}>
                {p.id === 'easy-pdf-free' ? (
                  <>
                    <Picture src={eps1} formats={["avif", "webp"]} fallbackFormat="webp" widths={[240, 360]} sizes="(min-width:760px) 180px, 40vw" alt={isEn ? 'Easy PDF Free home screen' : 'Pantalla de inicio de Easy PDF Free'} data-par />
                    <Picture src={eps2} formats={["avif", "webp"]} fallbackFormat="webp" widths={[240, 360]} sizes="(min-width:760px) 180px, 40vw" alt={isEn ? 'Reader with large controls' : 'Lector con controles grandes'} data-par />
                  </>
                ) : (
                  <Picture
                    src={images[p.id]}
                    formats={["avif", "webp"]} fallbackFormat="webp"
                    widths={mediaClass[p.id] && p.id !== 'gletir-tracker' ? [400, 600] : [480, 720, 960, 1200]}
                    sizes={mediaClass[p.id] && p.id !== 'gletir-tracker' ? '(min-width:760px) 300px, 70vw' : p.id === 'gletir-tracker' ? '(min-width:1120px) 580px, (min-width:760px) 55vw, 92vw' : '(min-width:1120px) 540px, (min-width:760px) 46vw, 92vw'}
                    alt={isEn ? `Screenshot of ${p.title}` : `Captura de ${p.title}`}
                    data-par
                  />
                )}
                <span class="mview" aria-hidden="true">{t.projects.detail} ↗</span>
                {mobile[p.id] && (
                  <>
                    <div class="phone">
                      <i class="notch" aria-hidden="true"></i>
                      <Picture src={mobile[p.id]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[200, 300]} sizes="130px" alt={isEn ? `${p.title} on mobile` : `${p.title} en móvil`} />
                    </div>
                  </>
                )}
              </div>
              <div class="pbody">
                <span class="type">{t.projects.types[p.type]}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                {p.price && <p class="price"><strong>{p.price}</strong></p>}
                {p.note && <p class="pnote">{p.note}</p>}
                <ul class="dpts" hidden>
                  <li class="dh">{t.projects.highlights}</li>
                  {p.points.map((x) => <li>{x}</li>)}
                </ul>
                <ul class="tags">{p.tags.map((g) => <li>{g}</li>)}</ul>
                <div class="links">
                  {p.store && <a class="btn btn-p" href={p.store} target="_blank" rel="noopener">{t.projects.store} ↗</a>}
                  {p.landing && <a class="btn btn-s" href={p.landing} target="_blank" rel="noopener">{t.projects.more} ↗</a>}
                  {p.demo && <a class="btn btn-p" href={p.demo} target="_blank" rel="noopener">{t.projects.demo} ↗</a>}
                  {p.code && <a class="btn btn-s" href={p.code} target="_blank" rel="noopener">{t.projects.code} ↗</a>}
                  <button type="button" class="btn btn-s" data-open aria-haspopup="dialog">{t.projects.detail}</button>
                </div>
              </div>
            </article>
            </Fragment>
          ))}
        </div>
      </div>
    </section>

    <section id="trabajo" class="cv" style="--m:1500px;--d:620px">
      <div class="wrap">
        <p class="kick" data-r>{t.work.kicker}</p>
        <h2 data-r>{t.work.title}</h2>
        <p class="sub" data-r>{t.work.lead}</p>
        <div class="wgrid">
          {t.work.items.map((w) => (
            <article class="card wcard" data-r="card">
              <span class="type">{w.type}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              <p class="wrole"><b>{t.work.role}:</b> {w.role}</p>
              {w.link && <a class="btn btn-s" href={w.link} target="_blank" rel="noopener">{t.work.visit} ↗</a>}
              {w.links && <div class="wlinks">{w.links.map((k) => <a class="btn btn-s" href={k.url} target="_blank" rel="noopener">{k.label} ↗</a>)}</div>}
            </article>
          ))}
        </div>
        <p class="wnote" data-r>{t.work.note}</p>
      </div>
    </section>

    <section id="sobre-mi" class="alt cv" style="--m:1500px;--d:1000px">
      <div class="wrap about">
        <div class="txt">
          <p class="kick" data-r>{t.about.kicker}</p>
          <h2 data-r>{t.about.title}</h2>
          <div data-r style="margin-top:20px">
            {t.about.paragraphs.map((p) => <p>{p}</p>)}
            <a class="ghl" href={t.github} target="_blank" rel="noopener">{t.about.github} ↗</a>
            <a class="ghl" href={t.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
        <div class="aside">
          <figure class="foto" data-r="card">
            <Picture src={foto} formats={["avif", "webp"]} fallbackFormat="webp" widths={[280, 420, 560]} sizes="(min-width:900px) 300px, 70vw" alt="Gustavo Bentancor" />
          </figure>
          <ul class="pts">
            {t.about.points.map((p) => <li data-r="card">{p}</li>)}
          </ul>
        </div>
      </div>
      <div class="wrap skills">
        <h3 data-r>{t.about.skillsTitle}</h3>
        <div class="sgrid">
          {t.about.skills.map((g) => (
            <div class="sgroup" data-r="card">
              <h4>{g.title}</h4>
              <ul class="tags sk">{g.items.map(([label, key]) => (
                <li>
                  <svg aria-hidden="true"><use href={`${base}/icons.svg#${key}`} /></svg>
                  {label}
                </li>
              ))}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="contact cv" style="--m:540px;--d:650px">
      <div class="wrap">
        <div class="box" data-r>
          <p class="kick">{t.contact.kicker}</p>
          <h2>{t.contact.title}</h2>
          <p class="sub">{t.contact.text}</p>
          <form class="cform" data-form novalidate action={ENDPOINT} method="post" data-endpoint={ENDPOINT} data-lang={t.lang} data-sitekey={SITEKEY} data-msg={JSON.stringify(t.contact.form)}>
            <fieldset class="opts">
              <legend>{t.contact.form.scopeLabel}</legend>
              <div class="orow">
                {Object.entries(t.contact.form.scope).map(([k, v]) => <label class="opt"><input type="radio" name="scope" value={k}><span>{v}</span></label>)}
              </div>
            </fieldset>
            <fieldset class="opts">
              <legend>{t.contact.form.timeLabel}</legend>
              <div class="orow">
                {Object.entries(t.contact.form.time).map(([k, v]) => <label class="opt"><input type="radio" name="time" value={k}><span>{v}</span></label>)}
              </div>
            </fieldset>
            <label>{t.contact.form.name}<input name="name" type="text" autocomplete="name" required maxlength="100"></label>
            <label>{t.contact.form.email}<input name="email" type="email" autocomplete="email" required maxlength="150" inputmode="email"></label>
            <label>{t.contact.form.message}<textarea name="message" rows="5" required minlength="10" maxlength="3000"></textarea></label>
            <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div data-ts></div>
            <button class="btn btn-p" type="submit">{t.contact.form.send}</button>
            <p class="fstat" role="status" aria-live="polite" data-status></p>
          </form>
          <span class="mail">{t.contact.form.or} <a href={`mailto:${t.email}`}>{t.contact.emailLabel}</a> · <a href={t.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></span>
        </div>
      </div>
    </section>
  </main>

  <dialog class="dlg" data-dlg aria-label={t.projects.title}>
    <button type="button" class="dx" data-close aria-label={t.projects.close}>×</button>
    <div class="dscroll"><div data-dmedia></div><div class="pbody" data-dbody></div></div>
  </dialog>

  <footer>
    <div class="wrap">
      <span>{t.footer}</span>
      <span class="flinks"><a href={t.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={t.github} target="_blank" rel="noopener">GitHub</a></span>
    </div>
  </footer>

  <script>
    // Filtros por categoria y detalle en <dialog> nativo (se mejora lo que ya existe; sin JS todo sigue visible).
    const grid = document.querySelector('.pgrid');
    const bar = document.querySelector('[data-filters]');
    const dlg = document.querySelector('[data-dlg]');
    if (grid && bar) {
      bar.hidden = false;
      bar.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-f]');
        if (!b) return;
        const f = b.dataset.f;
        bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        grid.querySelectorAll('article[data-cat]').forEach((a) => { a.hidden = f !== 'all' && a.dataset.cat !== f; });
        grid.querySelectorAll('.ghead').forEach((h) => { h.hidden = f !== 'all'; });
      });
    }
    if (grid && dlg) {
      const dm = dlg.querySelector('[data-dmedia]');
      const db = dlg.querySelector('[data-dbody]');
      grid.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-open], .media');
        if (!btn) return;
        const card = btn.closest('article');
        const media = card.querySelector('.media').cloneNode(true);
        media.querySelectorAll('source,img').forEach((x) => { x.sizes = '(min-width:900px) 860px, 96vw'; if (x.loading) x.loading = 'eager'; });
        const body = card.querySelector('.pbody').cloneNode(true);
        body.querySelector('[data-open]').remove();
        const pts = body.querySelector('.dpts');
        pts.hidden = false;
        dm.replaceChildren(media);
        db.replaceChildren(...body.childNodes);
        dlg.showModal();
        dlg.querySelector('.dscroll').scrollTop = 0;
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.closest('[data-close]')) dlg.close(); });
    }
  </script>
  <script>
    // Formulario: AJAX hacia contact.php. Turnstile (si hay site key) se carga solo al enfocar el formulario.
    const form = document.querySelector('[data-form]');
    if (form) {
      const msg = JSON.parse(form.dataset.msg);
      const status = form.querySelector('[data-status]');
      const btn = form.querySelector('button');
      const t0 = Date.now();
      let cf = '';
      let tsLoaded = false;
      const loadTs = () => {
        const key = form.dataset.sitekey;
        if (!key || tsLoaded) return;
        tsLoaded = true;
        window.__tsReady = () => window.turnstile.render(form.querySelector('[data-ts]'), { sitekey: key, callback: (tk) => (cf = tk), 'expired-callback': () => (cf = '') });
        const sc = document.createElement('script');
        sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__tsReady';
        sc.async = true;
        document.head.appendChild(sc);
      };
      form.addEventListener('focusin', loadTs, { once: true });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'fstat';
        const d = Object.fromEntries(new FormData(form));
        if (!form.checkValidity()) {
          status.textContent = form.email.validity.valid ? msg.invalid : msg.email_bad;
          status.classList.add('bad');
          return;
        }
        btn.disabled = true;
        status.textContent = msg.sending;
        try {
          const r = await fetch(form.dataset.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: d.name, email: d.email, message: d.message, scope: d.scope || '', time: d.time || '', website: d.website, lang: form.dataset.lang, t: t0, cf }),
          });
          const j = await r.json().catch(() => ({}));
          if (j.ok) {
            status.textContent = msg.ok;
            status.classList.add('good');
            form.reset();
          } else {
            status.textContent = msg[j.error === 'rate' ? 'rate' : j.error === 'captcha' ? 'captcha' : j.error === 'email' ? 'email_bad' : j.error === 'invalid' ? 'invalid' : 'err'];
            status.classList.add('bad');
            if (window.turnstile && cf) { window.turnstile.reset(); cf = ''; }
          }
        } catch (_) {
          status.textContent = msg.err;
          status.classList.add('bad');
        }
        btn.disabled = false;
      });
    }
  </script>
  <script>
    // GSAP: el modulo se descarga 4 s despues de `load`, cuando el navegador esta libre, y la
    // animacion arranca con la primera interaccion (scroll, toque, tecla) o a los 10 s.
    // Sin interaccion no hay trabajo extra en el hilo principal durante la carga.
    if (!matchMedia('(prefers-reduced-motion:reduce)').matches) {
      let mod;
      let go = false;
      const evs = ['scroll', 'touchstart', 'pointerdown', 'keydown', 'wheel'];
      const run = () => mod && mod.then((m) => m.init());
      const start = () => {
        if (go) return;
        go = true;
        evs.forEach((e) => removeEventListener(e, start));
        if (mod) run();
        else {
          mod = import('../scripts/anim.js');
          run();
        }
      };
      evs.forEach((e) => addEventListener(e, start, { passive: true }));
      // ?eager arranca GSAP en `load` (solo para medir el peor caso con Lighthouse)
      if (location.search.includes('eager')) addEventListener('load', start, { once: true });
      addEventListener('load', () => {
        const fetchMod = () => { if (!mod) { mod = import('../scripts/anim.js'); if (go) run(); } };
        // Espera 4 s tras `load` para no competir con la carga inicial; con interaccion antes, arranca antes.
        setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(fetchMod, { timeout: 2000 }) : fetchMod()), 4000);
        setTimeout(start, 10000);
      }, { once: true });
    }
  </script>
</body>
</html>
