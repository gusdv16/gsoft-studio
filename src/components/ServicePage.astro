---
import '../styles/global.css';
import { Picture } from 'astro:assets';
import { allItems } from '../lib/projects.js';
import { covers } from '../lib/covers.js';

const { t, service, lang } = Astro.props;
const isEn = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const CANON = 'https://gustavobentancor.com';
const path = isEn ? `/en/servicios/${service.slug}/` : `/servicios/${service.slug}/`;
const canonical = `${CANON}${path}`;
const altPath = isEn ? `/servicios/${service.slug}/` : `/en/servicios/${service.slug}/`;
const alt = `${CANON}${altPath}`;
const other = isEn ? `${base}/servicios/${service.slug}/` : `${base}/en/servicios/${service.slug}/`;
const homePath = isEn ? '/en/' : '/';
const projectsBase = isEn ? '/en/proyectos/' : '/proyectos/';

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: service.h1,
      description: service.description,
      url: canonical,
      provider: { '@id': `${CANON}/#org` },
      areaServed: { '@type': 'Country', name: 'Uruguay' },
      ...(service.priceRange ? { offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'USD', description: service.priceRange } } } : {}),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: service.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.brand, item: `${CANON}${isEn ? '/en/' : '/'}` },
        { '@type': 'ListItem', position: 2, name: service.h1, item: canonical },
      ],
    },
  ],
};

const all = allItems(t, base);
const relatedProjects = (service.related || []).map((id) => all.find((p) => p.id === id)).filter(Boolean);
const heroCover = relatedProjects.map((p) => covers[p.img ?? p.id]).filter(Boolean);
const others = t.services.items.filter((x) => x.slug !== service.slug);
const outLink = (p) => p.visit ?? p.demo ?? p.links?.[0]?.url ?? p.store ?? null;
const sprite = (k) => `${base}/icons.svg#${k}`;

const fontCss = `@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${base}/fonts/inter-latin-wght-normal.woff2") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{service.title}</title>
  <meta name="description" content={service.description}>
  <meta name="theme-color" content="#07080d">
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="es" href={isEn ? alt : canonical}>
  <link rel="alternate" hreflang="en" href={isEn ? canonical : alt}>
  <link rel="alternate" hreflang="x-default" href={isEn ? alt : canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={service.title}>
  <meta property="og:description" content={service.description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={t.brand}>
  <meta property="og:locale" content={isEn ? 'en_US' : 'es_ES'}>
  <meta property="og:image" content={`${CANON}/og.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={service.title}>
  <meta name="twitter:description" content={service.description}>
  <meta name="twitter:image" content={`${CANON}/og.png`}>
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="preload" href={`${base}/fonts/inter-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={fontCss}></style>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TEFWE35W1K"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
    gtag('js',new Date());gtag('config','G-TEFWE35W1K');
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="hd">
    <div class="wrap">
      <a class="logo" href={`${base}${homePath}`} aria-label={t.brand}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#10131e" stroke="#1f2434"/><path d="M9 21l5-10 4 7 2-4 3 7" fill="none" stroke="#7c8cff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {t.brand}
      </a>
      <nav class="nav" aria-label="Principal">
        <a href={`${base}${homePath}#sobre-mi`}>{t.nav.about}</a>
        <a href={`${base}${homePath}#proyectos`}>{t.nav.projects}</a>
        <a href={`${base}${homePath}#servicios`}>{t.nav.services}</a>
        <a href={`${base}${homePath}#contacto`}>{t.nav.contact}</a>
      </nav>
      <a class="lang" href={other} hreflang={isEn ? 'es' : 'en'} title={t.nav.other.title}>{t.nav.other.label}</a>
      <a class="btn btn-p" href={`${base}${homePath}#contacto`}>{t.nav.cta}</a>
    </div>
  </header>

  <main id="main">
    <section class="sv-hero">
      <div class="wrap sv-hgrid">
        <div class="sv-htext">
          <nav class="sv-crumb" aria-label={isEn ? 'Breadcrumb' : 'Ruta'}>
            <a href={`${base}${homePath}`}>{t.brand}</a><span aria-hidden="true">›</span><a href={`${base}${homePath}#servicios`}>{t.nav.services}</a>
          </nav>
          <h1>{service.h1}</h1>
          <p class="lead">{service.lead}</p>
          <ul class="facts">{(service.facts || []).map((x) => <li>{x}</li>)}</ul>
          <div class="cta">
            <a class="btn btn-p" href={`${base}${homePath}#contacto`}>{t.hero.primary}</a>
            <a class="btn btn-s" href={`${base}${homePath}#proyectos`}>{t.hero.secondary}</a>
          </div>
          {service.priceRange && <p class="sv-price"><svg aria-hidden="true"><use href={sprite(service.icon || 'code')} /></svg>{service.priceRange}</p>}
        </div>
        {heroCover.length > 0 && (
          <div class="sv-visual" aria-hidden="true">
            <div class="sv-browser">
              <div class="sv-bar"><i></i><i></i><i></i></div>
              <Picture src={heroCover[0]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(min-width:900px) 520px, 92vw" alt="" loading="eager" />
            </div>
            {heroCover[1] && (
              <div class="sv-mini">
                <Picture src={heroCover[1]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[240, 360]} sizes="200px" alt="" loading="lazy" />
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <section class="cv" style="--m:700px;--d:520px">
      <div class="wrap">
        <p class="kick" data-r>{isEn ? 'The problem' : 'El problema que resuelvo'}</p>
        <h2 data-r>{isEn ? 'What is holding you back' : 'Lo que te frena'}</h2>
        <ul class="sv-problems">
          {service.problems.map((x) => <li data-r="card"><b aria-hidden="true">✕</b><span>{x}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="alt cv" style="--m:760px;--d:560px">
      <div class="wrap">
        <p class="kick" data-r>{isEn ? 'The solution' : 'Cómo lo resuelvo'}</p>
        <h2 data-r>{isEn ? 'What you get' : 'Qué te entrego'}</h2>
        <ol class="sv-steps">
          {service.solution.map((x, i) => <li data-r="card"><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p>{x}</p></li>)}
        </ol>
      </div>
    </section>

    {relatedProjects.length > 0 && (
      <section class="cv" style="--m:900px;--d:600px">
        <div class="wrap">
          <p class="kick" data-r>{t.projects.kicker}</p>
          <h2 data-r>{isEn ? 'Related work' : 'Trabajos relacionados'}</h2>
          <div class="sv-cases">
            {relatedProjects.map((p) => {
              const img = covers[p.img ?? p.id];
              const ext = outLink(p);
              return (
                <article class="sv-case" data-r="card">
                  <a class="sv-cimg" href={`${base}${projectsBase}${p.id}/`} tabindex="-1" aria-hidden="true">
                    {img && <Picture src={img} formats={["avif", "webp"]} fallbackFormat="webp" widths={[400, 640]} sizes="(min-width:1000px) 300px, (min-width:640px) 45vw, 92vw" alt="" loading="lazy" />}
                  </a>
                  <div class="sv-cbody">
                    <span class="type">{p.kind ?? t.projects.types[p.type]}</span>
                    <h3>{p.title}</h3>
                    <p>{t.short[p.id] ?? p.text}</p>
                    <div class="links">
                      <a class="btn btn-p" href={`${base}${projectsBase}${p.id}/`}>{isEn ? 'View project' : 'Ver proyecto'}</a>
                      {ext && <a class="btn btn-s" href={ext} target="_blank" rel="noopener">{isEn ? 'Open' : 'Abrir'} ↗</a>}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <section class="alt cv" style="--m:800px;--d:600px">
      <div class="wrap sv-faqw">
        <p class="kick" data-r>{isEn ? 'FAQ' : 'Preguntas frecuentes'}</p>
        <h2 data-r>{isEn ? 'Frequently asked questions' : 'Lo que suelen preguntarme'}</h2>
        <div class="sv-faq">
          {service.faq.map((f) => (
            <details data-r="card">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cv" style="--m:500px;--d:400px">
      <div class="wrap">
        <p class="kick" data-r>{isEn ? 'More services' : 'Otros servicios'}</p>
        <ul class="sv-others">
          {others.map((o) => (
            <li data-r="card">
              <a href={`${base}${isEn ? '/en' : ''}/servicios/${o.slug}/`}>
                <span class="ico"><svg aria-hidden="true"><use href={sprite(o.icon)} /></svg></span>
                <b>{o.title}</b>
                <span>{o.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="contacto" class="contact cv" style="--m:540px;--d:650px">
      <div class="wrap">
        <div class="box" data-r>
          <p class="kick">{t.contact.kicker}</p>
          <h2>{t.contact.title}</h2>
          <p class="sub">{t.contact.text}</p>
          <a class="btn btn-p" href={`${base}${homePath}#contacto`}>{t.hero.primary}</a>
          <span class="mail" style="display:block;margin-top:14px">{t.contact.form.or} <button type="button" class="mailbtn" data-mail data-u={t.emailEnc} data-copied={t.contact.copiedEmail} data-open-label={t.contact.openMail} aria-label={t.contact.mailAria}><svg aria-hidden="true"><use href={`${base}/icons.svg#mail`} /></svg><span data-l>{t.contact.copyEmail}</span></button> · <a href={t.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></span>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>{t.footer}</span>
      <span class="flinks"><a href={t.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={t.github} target="_blank" rel="noopener">GitHub</a><a href={`${base}/${t.cv.file}`} download={t.cv.name} data-cv>CV</a></span>
    </div>
  </footer>
  <script>
    import '../scripts/mail.js';
  </script>
</body>
</html>
---
