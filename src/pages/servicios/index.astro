---
import '../../styles/global.css';
import es from '../../i18n/es.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const CANON = 'https://gustavobentancor.com';
const title = 'Servicios | Gustavo Bentancor';
const description = 'Servicios de Gustavo Bentancor: desarrollo web rápido, SEO técnico y rendimiento, sitios con panel de administración, rediseño y migración.';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#07080d">
  <link rel="canonical" href={`${CANON}/servicios/`}>
  <meta name="robots" content="index,follow">
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <style is:inline>{`@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${base}/fonts/inter-latin-wght-normal.woff2") format("woff2")}`}</style>
</head>
<body>
  <main id="main" style="max-width:900px;margin:0 auto;padding:60px 24px">
    <h1>Servicios</h1>
    <p style="margin:12px 0 32px;color:var(--muted)">Lo que puedo hacer por tu negocio.</p>
    <ul style="list-style:none;padding:0;display:grid;gap:16px">
      {es.servicePages.map((s) => (
        <li>
          <a href={`${base}/servicios/${s.slug}/`} style="display:block;padding:18px 20px;border:1px solid #1f2434;border-radius:12px;text-decoration:none">
            <strong>{s.h1}</strong>
            <p style="margin:6px 0 0;color:var(--muted);font-size:.95rem">{s.lead}</p>
          </a>
        </li>
      ))}
    </ul>
    <p style="margin-top:32px"><a href={`${base}/`}>← Volver al inicio</a></p>
  </main>
</body>
</html>
